# Only needed when running artisan on the host. `docker compose up` reads
# docker/app.env instead and needs no .env file.
APP_NAME="Notification System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=notifications
DB_USERNAME=notifications
DB_PASSWORD=notifications

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array
BROADCAST_CONNECTION=log
REDIS_QUEUE_RETRY_AFTER=45

NOTIFICATION_PROVIDER_URL=http://127.0.0.1:9000/send
WORKERS_PER_CHANNEL=4
FAIR_WORKERS_PER_CHANNEL=1
