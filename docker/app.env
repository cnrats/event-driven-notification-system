# Shared environment for every PHP container (API, workers, sweeper, Reverb).
# Demo values only: this file is committed so that `docker compose up` needs
# no manual step. Do not reuse the key or passwords anywhere real.
APP_NAME=Notification System
APP_ENV=local
APP_KEY=base64:d+txYBVD97gIHQTEBfPOK0QBakc7YnvhDcJ8jkNOVwM=
APP_DEBUG=false
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=notifications
DB_USERNAME=notifications
DB_PASSWORD=notifications

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array
BROADCAST_CONNECTION=reverb

# WebSocket server (Laravel Reverb). Demo credentials.
REVERB_APP_ID=notification-system
REVERB_APP_KEY=notification-system-key
REVERB_APP_SECRET=notification-system-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_PORT=8085

# Queue timing chain: provider timeout < job timeout < retry_after.
REDIS_QUEUE_RETRY_AFTER=45

# External provider. The bundled mock implements the contract from the brief.
# To use webhook.site instead, set your own URL here (free URLs accept 100
# requests and expire after 7 days, so keep load scenarios on the mock).
NOTIFICATION_PROVIDER_URL=http://mock-provider:9000/send

WORKERS_PER_CHANNEL=4
FAIR_WORKERS_PER_CHANNEL=1
