{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cnrats/notification-system",
    "type": "project",
    "description": "Event-driven notification system: REST API, queue workers, rate limiting, retries and real-time status.",
    "keywords": [
        "notifications",
        "laravel",
        "queues",
        "rate-limiting"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.17",
        "laravel/horizon": "^5.51",
        "laravel/reverb": "^1.13",
        "laravel/tinker": "^3.0",
        "nyholm/psr7": "^1.8",
        "open-telemetry/exporter-otlp": "^1.5",
        "open-telemetry/sdk": "^1.16",
        "promphp/prometheus_client_php": "^2.15"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.15",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "osteel/openapi-httpfoundation-testing": "^0.15.0",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": [
            "pint --test",
            "phpstan analyse --memory-limit=1G",
            "rector process --dry-run"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
